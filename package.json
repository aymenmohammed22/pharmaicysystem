{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "npx tsx server.ts",
    "build": "npx vite build",
    "start": "node server.ts",
    "preview": "npx vite preview",
    "clean": "rm -rf dist server.js electron/dist release",
    "lint": "npx tsc --noEmit",
    "electron:build": "npx vite build && npx esbuild electron/main.ts --bundle --platform=node --format=esm --target=node20 --external:electron --outfile=electron/dist/main.js && npx esbuild electron/preload.ts --bundle --platform=node --format=esm --target=node20 --external:electron --outfile=electron/dist/preload.js",
    "electron:package": "npm run electron:build && npx electron-builder --win --x64"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "bwip-js": "^4.11.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.itqansoft.omnipharmacy",
    "productName": "Omni Pharmacy System",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server.ts",
      "server/**/*",
      "shared/**/*",
      "electron/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Omni Pharmacy System"
    }
  }
}
